<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">


  <Dialog id="sortDialog" title="{i18n>sort}" contentWidth="26rem">
    <content>
      <VBox class="sapUiMediumMargin">
        <Label text="{i18n>sortBy}" labelFor="sortField" />
        <Select id="sortField" width="100%" selectedKey="{ui>/sortKey}"
                items="{path: 'ui>/sortFields', templateShareable: true}">
          <core:Item key="{ui>key}" text="{ui>text}" />
        </Select>

        <SegmentedButton selectedKey="{ui>/sortDirection}"
                         class="sapUiMediumMarginTop">
          <items>
            <SegmentedButtonItem key="ASC" text="{i18n>ascending}"
                                 icon="sap-icon://sort-ascending" />
            <SegmentedButtonItem key="DESC" text="{i18n>descending}"
                                 icon="sap-icon://sort-descending" />
          </items>
        </SegmentedButton>
      </VBox>
    </content>
    <beginButton>
      <Button text="{i18n>apply}" type="Emphasized" press="onSortApply" />
    </beginButton>
    <endButton>
      <Button text="{i18n>reset}" press="onSortReset" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
