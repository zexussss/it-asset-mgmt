<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core"
  xmlns:form="sap.ui.layout.form">


  <Dialog id="addEmployeeDialog" title="{i18n>addEmployee}" contentWidth="32rem">
    <content>
      <form:SimpleForm layout="ResponsiveGridLayout" editable="true"
                       class="sapUiMediumMargin" columnsXL="1" columnsL="1"
                       columnsM="1" labelSpanXL="4" labelSpanL="4"
                       labelSpanM="4" labelSpanS="12">
        <Label text="{i18n>employeeNumber}" />
        <Text text="{dlg>/employeeNumber}" class="itamCellMuted" />

        <Label text="{i18n>firstName}" required="true" />
        <Input id="employeeFirstName" value="{dlg>/firstName}"
               placeholder="{i18n>firstName}" />

        <Label text="{i18n>lastName}" required="true" />
        <Input id="employeeLastName" value="{dlg>/lastName}"
               placeholder="{i18n>lastName}" />

        <Label text="{i18n>email}" required="true" />
        <Input id="employeeEmail" type="Email" value="{dlg>/email}"
               placeholder="{i18n>email}" />

        <Label text="{i18n>department}" />
        <Input id="employeeDepartment" value="{dlg>/department}"
               placeholder="{i18n>department}" />
      </form:SimpleForm>
    </content>
    <beginButton>
      <Button text="{i18n>create}" type="Emphasized" press="onConfirmCreate" />
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press="onCancelCreate" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
