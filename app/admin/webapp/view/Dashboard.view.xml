<mvc:View controllerName="admin.controller.Dashboard"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core">

  <Page showHeader="false" enableScrolling="true" class="itamPage">
    <content>
      <VBox class="itamPageContent">

        <core:Fragment fragmentName="common.fragment.PageHeader" type="XML" />


        <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
          <GenericTile class="itamKpiTile" frameType="OneByOne"
                       header="{i18n>kpiAssets}" subheader="{i18n>kpiAssetsSub}"
                       press="onNavAssets">
            <TileContent unit="{i18n>kpiUnitAssets}">
              <NumericContent value="{ui>/kpi/assets}" withMargin="false"
                              icon="sap-icon://laptop" class="itamKpiValue" />
            </TileContent>
          </GenericTile>

          <GenericTile class="itamKpiTile" frameType="OneByOne"
                       header="{i18n>kpiOpen}" subheader="{i18n>kpiOpenSub}"
                       press="onNavOpenRequests">
            <TileContent unit="{i18n>kpiUnitRequests}">
              <NumericContent value="{ui>/kpi/open}" withMargin="false"
                              icon="sap-icon://wrench" valueColor="Critical"
                              class="itamKpiValue" />
            </TileContent>
          </GenericTile>

          <GenericTile class="itamKpiTile" frameType="OneByOne"
                       header="{i18n>kpiInRepair}" subheader="{i18n>kpiInRepairSub}"
                       press="onNavInRepair">
            <TileContent unit="{i18n>kpiUnitAssets}">
              <NumericContent value="{ui>/kpi/inRepair}" withMargin="false"
                              icon="sap-icon://physical-activity" class="itamKpiValue" />
            </TileContent>
          </GenericTile>

          <GenericTile class="itamKpiTile" frameType="OneByOne"
                       header="{i18n>kpiEmployees}" subheader="{i18n>kpiEmployeesSub}"
                       press="onNavEmployees">
            <TileContent unit="{i18n>kpiUnitPeople}">
              <NumericContent value="{ui>/kpi/employees}" withMargin="false"
                              icon="sap-icon://employee" class="itamKpiValue" />
            </TileContent>
          </GenericTile>
        </HBox>


        <Panel class="itamPanel">
          <headerToolbar>
            <OverflowToolbar class="itamPanelHeader">
              <VBox>
                <Title text="{i18n>latestRequests}" level="H3" class="itamPanelTitle" />
                <Text text="{i18n>latestRequestsSub}" class="itamPanelSubtitle" />
              </VBox>
              <ToolbarSpacer />
              <Button text="{i18n>viewAll}" type="Transparent" press="onNavRepairRequests"
                      icon="sap-icon://navigation-right-arrow" iconFirst="false" />
            </OverflowToolbar>
          </headerToolbar>

          <Table class="itamTable" inset="false" mode="SingleSelectMaster"
                 selectionChange="onRequestSelect" noDataText="{i18n>noData}"
                 items="{
                   path: '/RepairRequests',
                   parameters: { $expand: 'asset,status,priority' },
                   sorter: { path: 'createdDate', descending: true },
                   length: 6
                 }">
            <columns>
              <Column width="9rem"><Text text="{i18n>asset}" /></Column>
              <Column><Text text="{i18n>description}" /></Column>
              <Column><Text text="{i18n>priority}" /></Column>
              <Column><Text text="{i18n>status}" /></Column>
              <Column><Text text="{i18n>createdDate}" /></Column>
            </columns>
            <items>
              <ColumnListItem type="Navigation" vAlign="Middle">
                <cells>
                  <Text text="{asset/inventoryNumber}" class="itamCellStrong" />
                  <Text text="{description}" maxLines="1" />
                  <ObjectStatus class="itamPill" text="{priority/name}"
                    state="{path: 'priority/criticality', formatter: '.formatter.critState'}" />
                  <ObjectStatus class="itamPill" text="{status/name}"
                    state="{path: 'status/criticality', formatter: '.formatter.critState'}"
                    icon="{path: 'status/criticality', formatter: '.formatter.critIcon'}" />
                  <Text text="{createdDate}"
                        class="itamCellMuted" />
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </Panel>

      </VBox>
    </content>
  </Page>
</mvc:View>
