<mvc:View controllerName="employee.controller.MyRepairRequests"
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core">

  <Page showHeader="false" enableScrolling="true" class="itamPage">
    <content>
      <VBox class="itamPageContent">

        <core:Fragment fragmentName="common.fragment.PageHeader" type="XML" />
        <core:Fragment fragmentName="common.fragment.ListToolbar" type="XML" />

        <Panel class="itamPanel">
          <headerToolbar>
            <OverflowToolbar class="itamPanelHeader">
              <HBox alignItems="Center">
                <Title text="{i18n>myRepairRequests}" level="H3" class="itamPanelTitle" />
                <Text text="{ui>/count}" class="itamCountBadge"
                      visible="{= ${ui>/count} !== null }" />
              </HBox>
              <ToolbarSpacer />
              <Button icon="sap-icon://action-settings" type="Transparent"
                      press="onPanelMenu" tooltip="{i18n>panelSettings}" />
            </OverflowToolbar>
          </headerToolbar>

          <Table id="mainTable" class="itamTable" inset="false"
                 mode="SingleSelectMaster" selectionChange="onSelect"
                 growing="true" growingThreshold="20"
                 updateFinished="onUpdateFinished"
                 noDataText="{i18n>noRequests}"
                 items="{
                   path: '/MyRepairRequests',
                   parameters: { $count: true, $expand: 'status,priority' },
                   sorter: { path: 'createdDate', descending: true }
                 }">
            <columns>
              <Column width="9rem"><Text text="{i18n>asset}" /></Column>
              <Column minScreenWidth="Tablet"><Text text="{i18n>description}" /></Column>
              <Column><Text text="{i18n>priority}" /></Column>
              <Column><Text text="{i18n>status}" /></Column>
              <Column minScreenWidth="Tablet"><Text text="{i18n>createdDate}" /></Column>
              <Column minScreenWidth="Desktop" demandPopin="true">
                <Text text="{i18n>technician}" />
              </Column>
            </columns>
            <items>
              <ColumnListItem type="Navigation" vAlign="Middle">
                <cells>
                  <Text text="{assetInventoryNumber}" class="itamCellStrong" />
                  <VBox>
                    <Text text="{description}" maxLines="2" />
                    <Text text="{assetName}" class="itamCellMuted" />
                  </VBox>
                  <ObjectStatus class="itamPill" text="{priority/name}"
                    state="{path: 'priority/criticality', formatter: '.formatter.critState'}" />
                  <ObjectStatus class="itamPill"
                    text="{status/name}"
                    state="{path: 'status/criticality', formatter: '.formatter.critState'}"
                    icon="{path: 'status/criticality', formatter: '.formatter.critIcon'}" />
                  <Text text="{createdDate}"
                        class="itamCellMuted" />
                  <Text text="{technician}" />
                </cells>
              </ColumnListItem>
            </items>
          </Table>
        </Panel>

      </VBox>
    </content>
  </Page>
</mvc:View>
